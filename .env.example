# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me-run-python-c-import-secrets-print-secrets.token_hex-32

# Upload Settings
UPLOAD_FOLDER=uploads/exams
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# Server Settings
HOST=0.0.0.0
PORT=5000
DEBUG=False

# ── Gemini API keys ─────────────────────────────────────────────
# Paste one key per line. Blank slots are ignored; one marking worker runs
# per key (see MARKING_WORKERS_PER_KEY). Keys only add capacity if each comes
# from a DIFFERENT Google Cloud project — quota is shared per project.
# Never commit this file — it is in .gitignore.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=


# Model used for marking. Change only after running tools/benchmark.py.
GEMINI_MODEL=gemini-3.6-flash
# Optional: used only when GEMINI_MODEL is overloaded (503 "high demand").
# Blank = never switch. Benchmark it first — each result records its model.
GEMINI_FALLBACK_MODEL=
# Optional: minimal / low / medium / high. Blank = model default.
# Lower is faster and cheaper — benchmark before changing.
GEMINI_THINKING_LEVEL=
# Output budget (thinking + report). The re-try budget is used once when a reply comes back cut off.
GEMINI_MAX_OUTPUT_TOKENS=32768
GEMINI_RETRY_OUTPUT_TOKENS=65536

# ── Page images sent to the AI (D2.5) — benchmark-gated, off until tested ──
# 1 = rotate phone photos upright using their EXIF tag (originals on disk untouched)
PAGE_EXIF_ROTATE=0
# Downscale pages whose long edge is larger than this many pixels (0 = off; try 2400)
PAGE_MAX_EDGE=0

# Web server threads (single process)
SERVER_THREADS=8

# Marking jobs run at the same time per key. Keep 1 on free-tier keys; paid
# keys with high rate limits can use 2–4 for a big speed-up.
MARKING_WORKERS_PER_KEY=1
